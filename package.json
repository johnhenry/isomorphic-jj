{
  "name": "@johnhenry/isomorphic-jj",
  "version": "0.2.0",
  "description": "Jujutsu (jj) version control semantics in pure JavaScript — stable change IDs, fearless undo, no staging area — for Node.js and browsers",
  "type": "module",
  "bin": {
    "isojj": "./bin/isojj.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./src/types.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/types.d.ts"
    },
    "./browser": {
      "import": "./src/browser/index.js",
      "types": "./src/browser/index.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node demo.mjs",
    "examples": "for f in examples/*.mjs; do echo \"=== $f\"; node \"$f\" || exit 1; done",
    "example:01": "node examples/01-init-commit-log.mjs",
    "example:02": "node examples/02-stacked-changes.mjs",
    "example:03": "node examples/03-history-editing.mjs",
    "example:04": "node examples/04-branching-and-merging.mjs",
    "example:05": "node examples/05-conflicts.mjs",
    "example:06": "node examples/06-revsets.mjs",
    "example:07": "node examples/07-bookmarks-and-tags.mjs",
    "example:08": "node examples/08-git-interop.mjs",
    "example:09": "node examples/09-config.mjs",
    "example:10": "node examples/10-undo-and-oplog.mjs",
    "example:11": "node examples/11-file-operations.mjs",
    "example:12": "node examples/12-browser.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:browser": "playwright test",
    "build": "rollup -c",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "version-control",
    "jujutsu",
    "jj",
    "git",
    "isomorphic",
    "browser",
    "nodejs",
    "change-tracking",
    "undo",
    "revsets"
  ],
  "author": "John Henry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/isomorphic-jj.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/isomorphic-jj/issues"
  },
  "homepage": "https://opensource.johnhenry.me/isomorphic-jj/",
  "peerDependencies": {
    "isomorphic-git": "^1.24.0"
  },
  "peerDependenciesMeta": {
    "isomorphic-git": {
      "optional": true
    }
  },
  "devDependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.0",
    "@playwright/test": "^1.40.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "isomorphic-git": "^1.34.2",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rollup": "^4.8.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "protobufjs": "^7.5.4"
  }
}
